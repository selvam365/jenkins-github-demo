
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out the source code!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application!'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the application!'
            }
        }
    }
}
